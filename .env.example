# Contoh konfigurasi — copy ke .env lalu sesuaikan
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_db
DB_USER=tsany
DB_PASS=ryzen2004
APP_URL=http://localhost:8080
APP_ENV=local

# SIMRS (sumber user eksternal, PostgreSQL server sama)
SIMRS_DB_HOST=localhost
SIMRS_DB_PORT=5432
SIMRS_DB_NAME=db_rswb_dummy
# Kosongkan = ikut DB_USER/DB_PASS di atas
SIMRS_DB_USER=
SIMRS_DB_PASS=
# WAJIB diisi di .env server: Yii seckey SIMRS (jangan commit)
SIMRS_SECKEY=
# Hidupkan setelah verifikasi end-to-end: true/false
SIMRS_AUTH_ENABLED=false
